# Domain MUST be a zone managed by your Cloudflare account.
BASE_DOMAIN=example.com
PANEL_SUBDOMAIN=panel
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
SESSION_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARS
CLOUDFLARE_API_TOKEN=REPLACE_WITH_CLOUDFLARE_DNS_EDIT_TOKEN
# Enable for real HTTPS deployment. Set false only for localhost development.
COOKIE_SECURE=true
# Allows registration ONLY of public global unicast IPv4 targets, never private/local addresses.
TARGET_PROTOCOL=http
MONGO_URI=mongodb://mongo:27017/expose
PORT=8080
